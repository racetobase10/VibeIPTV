<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="@dimen/screen_margin">

    <TextView
        style="@style/Text.MyTVPlayer.Headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recordings" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecordings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/spacing_8"
        android:clipToPadding="false" />

    <LinearLayout
        android:id="@+id/txtEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/spacing_24"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textSize="48sp"
            android:textColor="@color/live_badge" />

        <TextView
            style="@style/Text.MyTVPlayer.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="No recordings yet" />

        <TextView
            style="@style/Text.MyTVPlayer.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:gravity="center"
            android:text="Record live TV from the player to watch it here."
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</LinearLayout>
