<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero: backdrop art with bottom gradient scrim -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <ImageView
                android:id="@+id/imgBackdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_image_placeholder"
                android:clipToOutline="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_gravity="bottom"
                android:background="@drawable/scrim_bottom_gradient" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_16">

            <ImageView
                android:id="@+id/imgPoster"
                android:layout_width="140dp"
                android:layout_height="210dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_image_placeholder"
                android:clipToOutline="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_16"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTitle"
                    style="@style/Text.MyTVPlayer.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/txtMeta"
                    style="@style/Text.MyTVPlayer.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8" />

                <TextView
                    android:id="@+id/txtExtRating"
                    style="@style/Text.MyTVPlayer.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:textColor="@color/star"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Primary actions: Play (filled) + Resume / Favorite (ghost) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_16">

            <Button
                android:id="@+id/btnPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶ Play"
                android:focusable="true"
                android:background="@drawable/btn_accent_focusable"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnResume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_8"
                android:visibility="gone"
                android:focusable="true"
                android:background="@drawable/btn_ghost_focusable"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnFav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_8"
                android:text="☆ Favorite"
                android:focusable="true"
                android:background="@drawable/btn_ghost_focusable"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <TextView
            style="@style/Text.MyTVPlayer.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_16"
            android:paddingTop="@dimen/spacing_16"
            android:text="Plot" />

        <TextView
            android:id="@+id/txtPlot"
            style="@style/Text.MyTVPlayer.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_16"
            android:paddingTop="@dimen/spacing_8"
            android:textColor="@color/text_primary" />

        <TextView
            style="@style/Text.MyTVPlayer.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_16"
            android:paddingTop="@dimen/spacing_16"
            android:text="Director" />

        <TextView
            android:id="@+id/txtDirector"
            style="@style/Text.MyTVPlayer.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_16"
            android:paddingTop="@dimen/spacing_8"
            android:textColor="@color/text_primary" />

        <TextView
            style="@style/Text.MyTVPlayer.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_16"
            android:paddingTop="@dimen/spacing_16"
            android:text="Cast" />

        <TextView
            android:id="@+id/txtCast"
            style="@style/Text.MyTVPlayer.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_16"
            android:paddingTop="@dimen/spacing_8"
            android:paddingBottom="@dimen/spacing_24"
            android:textColor="@color/text_primary" />
    </LinearLayout>
</ScrollView>
