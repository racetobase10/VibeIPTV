<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Portal"
            style="@style/Text.MyTVPlayer.Headline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="Bring your own provider — no streams are included."
            style="@style/Text.MyTVPlayer.Body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTypeXtream"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/btn_accent_focusable"
                android:focusable="true"
                android:text="Xtream Codes"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnTypeM3u"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_12"
                android:layout_weight="1"
                android:background="@drawable/btn_ghost_focusable"
                android:focusable="true"
                android:text="M3U Playlist"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutXtream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/item_focusable"
                android:focusable="true"
                android:hint="Portal name"
                android:inputType="text"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="@dimen/text_body" />

            <EditText
                android:id="@+id/etServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:background="@drawable/item_focusable"
                android:focusable="true"
                android:hint="http://host:port"
                android:inputType="textUri"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="@dimen/text_body" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:background="@drawable/item_focusable"
                android:focusable="true"
                android:hint="Username"
                android:inputType="text"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="@dimen/text_body" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:background="@drawable/item_focusable"
                android:focusable="true"
                android:hint="Password"
                android:inputType="textPassword"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutM3u"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etM3uName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/item_focusable"
                android:focusable="true"
                android:hint="Playlist name"
                android:inputType="text"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="@dimen/text_body" />

            <EditText
                android:id="@+id/etM3uUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:background="@drawable/item_focusable"
                android:focusable="true"
                android:hint="Playlist URL (.m3u / .m3u8)"
                android:inputType="textUri"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="@dimen/text_body" />

            <EditText
                android:id="@+id/etM3uEpg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:background="@drawable/item_focusable"
                android:focusable="true"
                android:hint="EPG URL (optional, xmltv)"
                android:inputType="textUri"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_16"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:background="@drawable/btn_accent_focusable"
            android:focusable="true"
            android:text="Save &amp; Connect"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:background="@drawable/btn_ghost_focusable"
            android:focusable="true"
            android:text="Cancel"
            android:textColor="@color/text_primary"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
