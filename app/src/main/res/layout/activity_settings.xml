<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <TextView
            style="@style/Text.MyTVPlayer.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Portal" />

        <TextView
            android:id="@+id/txtPortalInfo"
            style="@style/Text.MyTVPlayer.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:textColor="@color/text_primary" />

        <LinearLayout
            android:id="@+id/rowManagePortals"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_row_height"
            android:layout_marginTop="@dimen/spacing_8"
            android:background="@drawable/item_focusable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_12">

            <TextView
                style="@style/Text.MyTVPlayer.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Manage portals"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <TextView
            style="@style/Text.MyTVPlayer.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="Playback" />

        <LinearLayout
            android:id="@+id/rowDecoder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_row_height"
            android:layout_marginTop="@dimen/spacing_8"
            android:background="@drawable/item_focusable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_12">

            <TextView
                style="@style/Text.MyTVPlayer.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Decoder mode"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/btnDecoder"
                style="@style/Text.MyTVPlayer.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowBuffer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_row_height"
            android:layout_marginTop="@dimen/spacing_8"
            android:background="@drawable/item_focusable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_12">

            <TextView
                style="@style/Text.MyTVPlayer.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Buffer size"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/btnBuffer"
                style="@style/Text.MyTVPlayer.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <TextView
            style="@style/Text.MyTVPlayer.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="EPG" />

        <LinearLayout
            android:id="@+id/rowEpgRefresh"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_row_height"
            android:layout_marginTop="@dimen/spacing_8"
            android:background="@drawable/item_focusable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_12">

            <TextView
                style="@style/Text.MyTVPlayer.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Refresh EPG now"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/txtEpgUpdated"
                style="@style/Text.MyTVPlayer.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowEpgClear"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_row_height"
            android:layout_marginTop="@dimen/spacing_8"
            android:background="@drawable/item_focusable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_12">

            <TextView
                style="@style/Text.MyTVPlayer.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clear EPG cache"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <TextView
            style="@style/Text.MyTVPlayer.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="Ratings" />

        <LinearLayout
            android:id="@+id/rowTmdbKey"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_row_height"
            android:layout_marginTop="@dimen/spacing_8"
            android:background="@drawable/item_focusable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_12">

            <TextView
                style="@style/Text.MyTVPlayer.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TMDB API key"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/btnTmdbKey"
                style="@style/Text.MyTVPlayer.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowOmdbKey"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_row_height"
            android:layout_marginTop="@dimen/spacing_8"
            android:background="@drawable/item_focusable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_12">

            <TextView
                style="@style/Text.MyTVPlayer.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OMDb API key"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/btnOmdbKey"
                style="@style/Text.MyTVPlayer.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <TextView
            style="@style/Text.MyTVPlayer.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="Parental Control" />

        <LinearLayout
            android:id="@+id/rowSetPin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_row_height"
            android:layout_marginTop="@dimen/spacing_8"
            android:background="@drawable/item_focusable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_12">

            <TextView
                style="@style/Text.MyTVPlayer.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Set/Change PIN"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowRemovePin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_row_height"
            android:layout_marginTop="@dimen/spacing_8"
            android:background="@drawable/item_focusable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_12">

            <TextView
                style="@style/Text.MyTVPlayer.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Remove PIN"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowLockedCats"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_row_height"
            android:layout_marginTop="@dimen/spacing_8"
            android:background="@drawable/item_focusable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_12">

            <TextView
                style="@style/Text.MyTVPlayer.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Locked categories"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <TextView
            style="@style/Text.MyTVPlayer.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="About" />

        <TextView
            android:id="@+id/txtAbout"
            style="@style/Text.MyTVPlayer.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:layout_marginBottom="@dimen/spacing_16"
            android:text="Vibe IPTV v1.0\nOriginal software — bring your own portal. No streams included.\ncom.vibeiptv.app"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</ScrollView>
