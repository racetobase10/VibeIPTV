<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/screen_margin">

        <Button
            android:id="@+id/tabLive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Live"
            android:textAllCaps="false"
            android:focusable="true"
            android:background="@drawable/btn_accent_focusable"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/tabMovies"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_8"
            android:text="Movies"
            android:textAllCaps="false"
            android:focusable="true"
            android:background="@drawable/btn_ghost_focusable"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/tabSeries"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_8"
            android:text="Series"
            android:textAllCaps="false"
            android:focusable="true"
            android:background="@drawable/btn_ghost_focusable"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFavs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="@dimen/spacing_8" />

    <LinearLayout
        android:id="@+id/txtEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/spacing_24"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★"
            android:textSize="48sp"
            android:textColor="@color/star" />

        <TextView
            style="@style/Text.MyTVPlayer.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="No favorites yet" />

        <TextView
            style="@style/Text.MyTVPlayer.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:gravity="center"
            android:text="Star channels, movies and series to find them here."
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btnBrowseLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="Browse Live TV"
            android:textAllCaps="false"
            android:focusable="true"
            android:background="@drawable/btn_accent_focusable"
            android:textColor="@color/text_primary"
            android:paddingHorizontal="@dimen/spacing_24" />
    </LinearLayout>
</LinearLayout>
