<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name=".MyTvApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:banner="@drawable/banner"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyTVPlayer"
        android:usesCleartextTraffic="true">

        <!-- Entry point: decides PortalSetup vs Home -->
        <activity
            android:name=".ui.portal.PortalSetupActivity"
            android:exported="true"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- TV home-screen entry -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true"
            android:banner="@drawable/banner"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.portal.PortalManagerActivity" android:exported="false" />
        <activity android:name=".ui.live.LiveTvActivity" android:exported="false" />
        <activity
            android:name=".ui.player.PlayerActivity"
            android:exported="false"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"
            android:supportsPictureInPicture="true" />
        <activity android:name=".ui.guide.GuideActivity" android:exported="false" />
        <activity android:name=".ui.vod.MoviesActivity" android:exported="false" />
        <activity android:name=".ui.vod.VodDetailActivity" android:exported="false" />
        <activity android:name=".ui.series.SeriesActivity" android:exported="false" />
        <activity android:name=".ui.series.SeriesDetailActivity" android:exported="false" />
        <activity android:name=".ui.favorites.FavoritesActivity" android:exported="false" />
        <activity android:name=".ui.recordings.RecordingsActivity" android:exported="false" />
        <activity android:name=".ui.settings.SettingsActivity" android:exported="false" />

        <service
            android:name=".ui.recordings.RecordService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
